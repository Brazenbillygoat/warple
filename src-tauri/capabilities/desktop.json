{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-capability",
  "description": "Desktop permissions preserved for the Tauri v2 migration baseline.",
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "windows": [
    "main",
    "setting"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-set-ignore-cursor-events",
    "dialog:default",
    "fs:default",
    "fs:allow-copy-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    "log:default",
    "opener:default",
    "store:default"
  ]
}
